# Copy this file to .env for local work (never commit .env). On Hostinger, set the same names in hPanel.
# Leave a value empty to leave that service unconnected. HOW-TO-SETUP.md explains each part step by step, and
# `npm run check:services` tries each one you have filled in and says what to fix.

# MySQL connection string for the booking database, e.g. mysql://user:password@host:3306/database (HOW-TO-SETUP.md, step 2)
DATABASE_URL=

# Google Cloud OAuth client ID (the Google Calendar connection; HOW-TO-SETUP.md, step 1). The client type must be "Desktop app"
GOOGLE_CLIENT_ID=
# Google Cloud OAuth client secret
GOOGLE_CLIENT_SECRET=
# Long-lived refresh token for Hassan's Google account (made by the one-time `npm run google:connect`; the consent screen must say "In production")
GOOGLE_REFRESH_TOKEN=
# Which calendar receives the bookings; empty means the account's main calendar ("primary")
GOOGLE_CALENDAR_ID=

# SMTP server of the mailbox that sends the emails (HOW-TO-SETUP.md, step 3). All five lines are needed on Hostinger (NODE_ENV=production) and with any public PUBLIC_SITE_URL
SMTP_HOST=
# SMTP port, e.g. 465
SMTP_PORT=
# SMTP login name (usually the full mailbox address)
SMTP_USER=
# SMTP password for that mailbox (in .env, put it in double quotes if it contains # or a space; in hPanel type it without quotes)
SMTP_PASS=
# The sender shown on emails, e.g. HiveGen <connect@hivegen.co>
MAIL_FROM=

# Cloudflare Turnstile secret key (the bot check on the booking form; HOW-TO-SETUP.md, step 6); the public site key lives in content/site.yaml (settings.turnstileSiteKey) and must be set when the site is live
TURNSTILE_SECRET=

# Meta Conversions API access token (server-side PageView, Lead and Schedule events; HOW-TO-SETUP.md, step 4). Also needs metaPixelId in content/site.yaml; with either missing nothing is sent to Meta
META_CAPI_TOKEN=
# Event code from Meta Events Manager > Test events; only while testing, leave empty otherwise (while it is set, Meta counts no event for ads)
META_TEST_EVENT_CODE=

# Cloudflare Stream signing key ID (protects video links once streamSignedUrls is on; HOW-TO-SETUP.md, step 7; `npm run media` also uses it to download the client card images)
STREAM_SIGNING_KEY_ID=
# Cloudflare Stream signing key as base64 JWK
STREAM_SIGNING_KEY_JWK=

# Shared secret the Hostinger cron job sends to the scheduled-job addresses (HOW-TO-SETUP.md, step 8). Letters and numbers only (no % sign), e.g. from: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# The site's public address, used for links in emails, e.g. https://hivegen.co (http://localhost:4321 on your own computer)
PUBLIC_SITE_URL=

# Tests only: a MySQL you already have, for `npm run test:db` instead of the downloaded one. The test makes its own temporary database
# there and drops it at the end, e.g. mysql://user:password@host:3306/any_existing_database. Leave empty to use the downloaded MySQL.
# To check the SQL on Hostinger's own MySQL/MariaDB before launch, put the Hostinger database address here for that one run (HOW-TO-SETUP.md, step 2).
DATABASE_URL_TEST=
# Tests only: 1 runs the booking server with in-memory test services instead of real ones (ignored in production)
HIVEGEN_FAKES=
# Set to production on Hostinger (HOW-TO-SETUP.md, step 9); leave empty for local work
NODE_ENV=
