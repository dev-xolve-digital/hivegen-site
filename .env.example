# Copy this file to .env for local work (never commit .env). On Hostinger, set the same names in hPanel.
# Leave a value empty to leave that service unconnected.

# MySQL connection string for the booking database, e.g. mysql://user:password@host:3306/database
DATABASE_URL=

# Google Cloud OAuth client ID (the Google Calendar connection)
GOOGLE_CLIENT_ID=
# Google Cloud OAuth client secret
GOOGLE_CLIENT_SECRET=
# Long-lived refresh token for Hassan's Google account (made by the one-time connect step)
GOOGLE_REFRESH_TOKEN=
# Which calendar receives the bookings; empty means the account's main calendar ("primary")
GOOGLE_CALENDAR_ID=

# SMTP server of the mailbox that sends the emails
SMTP_HOST=
# SMTP port, e.g. 465
SMTP_PORT=
# SMTP login name (usually the full mailbox address)
SMTP_USER=
# SMTP password for that mailbox
SMTP_PASS=
# The sender shown on emails, e.g. HiveGen <connect@hivegen.co>
MAIL_FROM=

# Cloudflare Turnstile secret key (the bot check on the booking form); the public site key lives in content/site.yaml
TURNSTILE_SECRET=

# Meta Conversions API access token (server-side PageView, Lead and Schedule events). Also needs metaPixelId in content/site.yaml; with either missing nothing is sent to Meta
META_CAPI_TOKEN=
# Event code from Meta Events Manager > Test events; only while testing, leave empty otherwise
META_TEST_EVENT_CODE=

# Cloudflare Stream signing key ID (protects video links once streamSignedUrls is on)
STREAM_SIGNING_KEY_ID=
# Cloudflare Stream signing key as base64 JWK
STREAM_SIGNING_KEY_JWK=

# Shared secret the Hostinger cron job sends to the scheduled-job addresses (any long random text)
CRON_SECRET=

# The site's public address, used for links in emails, e.g. https://hivegen.co
PUBLIC_SITE_URL=

# Tests only: a MySQL you already have, for `npm run test:db` instead of the downloaded one. The test makes its own temporary database
# there and drops it at the end, e.g. mysql://user:password@host:3306/any_existing_database. Leave empty to use the downloaded MySQL.
DATABASE_URL_TEST=
# Tests only: 1 runs the booking server with in-memory test services instead of real ones (ignored in production)
HIVEGEN_FAKES=
# Set to production on Hostinger; leave empty for local work
NODE_ENV=
