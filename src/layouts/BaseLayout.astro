---
import '../styles/global.css';
import '../styles/site.css';
import { loadSite, loadImages } from '../lib/content/load';
import { scriptJson } from '../lib/text';

interface Props {
  seo: { title: string; description: string; noindex: boolean };
  /**
   * false for a page whose address is private (the manage page: its link is a secret): no tracker runs on it, and its links and
   * requests send no referrer, so no tracker on the page a visitor goes to next can see the address either.
   */
  tracking?: boolean;
}
const { seo, tracking = true } = Astro.props;
const site = loadSite();
const images = loadImages();
// Card images, the hero poster and screenshots come from Cloudflare Images: open that connection early.
const imageOrigin = Object.keys(images.images).length > 0 ? new URL(images.deliveryUrl).origin : undefined;
// The public ad-tracking ids from site.yaml, for scripts/tracking.ts. With none set (the real content has none yet) nothing is rendered
// and no third-party script is ever requested.
const trackingIds = tracking ? Object.fromEntries(Object.entries(site.tracking ?? {}).filter(([, id]) => id)) : {};
---
<!doctype html>
<html lang="en" data-live3d-mobile={site.settings.live3dOnMobile ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    {!tracking && <meta name="referrer" content="no-referrer" />}
    <meta name="theme-color" content="#FFF9EB" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={site.brand.logo} />
    {imageOrigin && <link rel="preconnect" href={imageOrigin} />}
    <link rel="preload" href="/fonts/archivo-display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-text.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
    <slot name="overlay" />
    {Object.keys(trackingIds).length > 0 && <script type="application/json" data-tracking set:html={scriptJson(trackingIds)} />}
    <script>
      import { initThree } from '../scripts/three/loader';
      import { bootTracking } from '../scripts/tracking';
      initThree();
      bootTracking(); // the Meta Pixel and Google tag: only with ids, and only after the page has loaded
    </script>
  </body>
</html>
