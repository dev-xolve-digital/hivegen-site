---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { listPages, loadSection, type Page } from '../lib/content/load';
import { assertNoSamplesInProduction } from '../lib/content/samples';

export function getStaticPaths() {
  assertNoSamplesInProduction();
  return listPages().map((page) => ({ params: { slug: page.slug || undefined }, props: { page } }));
}

interface Props { page: Page }
const { page } = Astro.props;
const hero = loadSection('hero');
---
<BaseLayout seo={page.seo}>
  <section class="sec hero-sec" id="top">
    <Nav />
    <div class="in" style="min-height:110svh">
      <a class="btn" data-hero-cta href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
    </div>
  </section>
  <Footer />
  <MobileBar />
</BaseLayout>
