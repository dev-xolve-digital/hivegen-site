---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Lightbox from '../components/Lightbox.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { listPages, type Page } from '../lib/content/load';
import { assertNoSamplesInProduction } from '../lib/content/samples';

export function getStaticPaths() {
  assertNoSamplesInProduction();
  return listPages().map((page) => ({ params: { slug: page.slug || undefined }, props: { page } }));
}

interface Props { page: Page }
const { page } = Astro.props;
---
<BaseLayout seo={page.seo}>
  <Hero page={page} />
  <Footer />
  <MobileBar />
  <Lightbox slot="overlay" />
</BaseLayout>
