---
import SampleTag from './SampleTag.astro';
import type { Screenshot } from '../lib/content/load';
interface Props { shots: Screenshot[]; direction: 'right' | 'left'; layer: 'front' | 'back' }
const { shots, layer } = Astro.props;
// The track holds two identical copies and slides by one copy, so one copy must be at least as wide
// as the widest screen, or a blank stretch scrolls through. Repeat the screenshots until a copy is
// about 2800px wide at the desktop card height (keep in step with .shot and .mq.back .shot in site.css).
const ROW_HEIGHT = layer === 'front' ? 270 : 236;
const GAP = 18;
const COVER_PX = 2800;
const setWidth = shots.reduce((w, s) => w + (s.width * ROW_HEIGHT) / s.height + GAP, 0);
const repeats = setWidth > 0 ? Math.ceil(COVER_PX / setWidth) : 1;
const copy = Array.from({ length: repeats }, (_, r) => shots.map((s) => ({ s, first: r === 0 }))).flat();
// Same speed whatever the number of cards (~9 s per card).
const dur = `${Math.max(copy.length, 1) * 9}s`;
---
<div class:list={['mq', layer]} data-testid={`marquee-${layer}`}>
  <div class="mq-track" data-track style={`--dur:${dur}`}>
    {[0, 1].map((c) => copy.map(({ s, first }) => {
      // Screen readers hear each screenshot once; the repeats are decoration.
      const hidden = c === 1 || !first;
      return (
        <figure class="shot" data-testid="shot" aria-hidden={hidden ? 'true' : undefined}>
          <img src={`/media/screenshots/${s.file}`} alt={hidden ? '' : s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" draggable="false" />
          <SampleTag show={s.sample} />
        </figure>
      );
    }))}
  </div>
</div>
<script>
  import { initMarquees } from '../scripts/marquee';
  initMarquees();
</script>
