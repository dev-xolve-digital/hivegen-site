---
import IgIcon from './IgIcon.astro';
import Three3D from './Three3D.astro';
import { loadSection, loadSite, type Page } from '../lib/content/load';
import { keepHyphenated, scriptJson } from '../lib/text';
interface Props { page: Page }
const { page } = Astro.props;
const b = loadSection('booking');
const site = loadSite();
const backupUrl = site.booking.backupUrl;
// What the script needs to say, as JSON. The calendar note is built here instead: its {backupLink} becomes a real link.
const copy = scriptJson({ errors: b.errors, timeNote: b.timeNote, noSlots: b.noSlots, confirmation: b.confirmation, requested: b.requested });
const rules = scriptJson(site.booking);
const [noteBefore, noteAfter] = b.calendarNote.split('{backupLink}');
---
<section class="sec" id="book" data-testid="booking">
  <div class="blob lime" style="width:440px;height:440px;left:-90px;top:-20px"></div>
  <div class="blob blue" style="width:440px;height:440px;right:-70px;bottom:-70px"></div>
  <Three3D slot="booking-pause" kind="pause" finish="blue" behind />
  <div class="in book glass" data-booking data-page={page.slug || 'main'}>
    <script type="application/json" data-booking-copy set:html={copy} />
    <script type="application/json" data-booking-rules set:html={rules} />
    <div>
      <h2 class="disp" set:html={keepHyphenated(b.heading)} />
      <p class="sub">{b.subline}</p>
      <ul>{b.bullets.map((x) => <li><span class="ck" aria-hidden="true">✓</span>{x}</li>)}</ul>
      <a class="ig u" href={site.contact.instagramUrl} target="_blank" rel="noopener"><IgIcon />{b.instagramLine}</a>
    </div>
    <div class="fwrap">
      <div class="form">
        <p class="draft-note" data-demo-note hidden>{b.demoNote}</p>
        <div data-flow>
          <div class="stepper" data-stepper aria-hidden="true">
            <span data-n="1" class="on"><span class="n">1</span>{b.steps.details}</span><span>→</span>
            <span data-n="2"><span class="n">2</span>{b.steps.time}</span>
          </div>

          <form data-step="details" method="post" action="#book">
            <div class="row2">
              <div class="fld"><label for="bk-name">{b.fields.name}</label><input class="inp" id="bk-name" name="name" data-field="name" autocomplete="name" aria-describedby="bk-name-err" /><span class="err" id="bk-name-err" data-error="name" role="alert" hidden></span></div>
              <div class="fld"><label for="bk-email">{b.fields.email}</label><input class="inp" id="bk-email" name="email" data-field="email" type="email" autocomplete="email" inputmode="email" aria-describedby="bk-email-err" /><span class="err" id="bk-email-err" data-error="email" role="alert" hidden></span></div>
            </div>
            <div class="fld"><label for="bk-phone">{b.fields.phone}</label><input class="inp" id="bk-phone" name="phone" data-field="phone" type="tel" autocomplete="tel" aria-describedby="bk-phone-err" /><span class="err" id="bk-phone-err" data-error="phone" role="alert" hidden></span></div>
            <fieldset class="fld" role="radiogroup" data-field="buyer" aria-describedby="bk-buyer-err"><legend>{b.fields.buyer}</legend>
              <div class="seg">{b.buyerOptions.map((o) => (
                <label><input type="radio" name="buyer" value={o.value} checked={page.preselectBuyer === o.value} /><span>{o.label}</span></label>
              ))}</div>
              <span class="err" id="bk-buyer-err" data-error="buyer" role="alert" hidden></span>
            </fieldset>
            <fieldset class="fld" role="radiogroup" data-field="volume" aria-describedby="bk-volume-err"><legend>{b.fields.volume}</legend>
              <div class="seg">{b.volumeOptions.map((v) => (
                <label><input type="radio" name="volume" value={v} /><span>{v}</span></label>
              ))}</div>
              <span class="err" id="bk-volume-err" data-error="volume" role="alert" hidden></span>
            </fieldset>
            <div class="fld"><label for="bk-footage">{b.fields.footage}</label><input class="inp" id="bk-footage" name="footage" data-field="footage" type="url" inputmode="url" aria-describedby="bk-footage-hint bk-footage-err" /><small class="hint" id="bk-footage-hint">{b.fields.footageHint}</small><span class="err" id="bk-footage-err" data-error="footage" role="alert" hidden></span></div>
            <div class="hp" aria-hidden="true"><label>{b.honeypotLabel}<input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <div data-turnstile></div>
            <p class="err" data-form-error role="alert" hidden></p>
            <button type="submit" class="btn" data-submit disabled>{b.nextLabel} <span class="arr" aria-hidden="true">→</span></button>
            <p class="consent">{b.consentLine}</p>
          </form>

          <div data-step="time" hidden>
            <h3 class="calh" data-time-heading tabindex="-1">{b.timeHeading}</h3>
            <p class="tz" data-time-note></p>
            <p class="calnote" data-calendar-note hidden>{backupUrl ? <>{noteBefore}<a class="u" href={backupUrl} target="_blank" rel="noopener">{b.backupLabel}</a>{noteAfter}</> : (noteBefore + noteAfter).trim()}</p>
            <div class="days" data-days></div>
            <div class="slots" data-slots></div>
            <p class="err" data-time-error role="alert" hidden></p>
            <div class="time-actions">
              <button type="button" class="btn ghost sm" data-back>{b.backLabel}</button>
              <button type="button" class="btn" data-confirm disabled>{b.confirmLabel}</button>
            </div>
          </div>

          <div class="done" data-testid="booking-done" tabindex="-1" hidden>
            <h3 class="disp" data-done-heading></h3>
            <p data-done-text></p>
            <div data-done-next>
              <p class="done-h">{b.confirmation.nextStepsHeading}</p>
              <ol data-done-steps></ol>
            </div>
            <div class="time-actions">
              <a class="btn" data-calendar href="#" target="_blank" rel="noopener">{b.confirmation.addToCalendar}</a>
              <a class="u" data-manage href="#book">{b.confirmation.manageLabel}</a>
              <a class="ig u" href={site.contact.instagramUrl} target="_blank" rel="noopener"><IgIcon />{b.confirmation.instagramLabel}</a>
            </div>
          </div>
        </div>

        <div class="offline" data-offline data-testid="booking-offline" hidden>
          <h3 class="disp">{b.offline.heading}</h3>
          <p>{b.offline.text}</p>
          <div class="time-actions">
            <a class="btn" href={site.contact.instagramUrl} target="_blank" rel="noopener"><IgIcon />{b.confirmation.instagramLabel}</a>
            {backupUrl && <a class="ig u" data-backup href={backupUrl} target="_blank" rel="noopener">{b.backupLabel}</a>}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  import { bootBooking } from '../scripts/booking-boot';
  import { browserStorage, captureAttribution } from '../scripts/attribution';
  import { trackLead, trackSchedule } from '../scripts/tracking';
  // Keep this visit's ad tags (the first touch wins for 30 days), then start the form. It asks the server and loads Cloudflare's bot check later.
  captureAttribution(new URL(location.href), browserStorage(window), Date.now());
  // The form tells the trackers when a lead is saved and a call is booked, with the event ids the server made (the Pixel and the Conversions API share them).
  document.querySelectorAll<HTMLElement>('[data-booking]').forEach((root) => bootBooking(root, { hooks: { onLead: trackLead, onSchedule: trackSchedule } }));
</script>
